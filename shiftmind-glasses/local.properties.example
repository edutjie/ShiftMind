# Per-developer config. NOT committed to git (see .gitignore).
# Android Studio also writes its SDK path here; we tack on ShiftMind-specific keys.

# Required: laptop server URL the glasses POST to.
# Find your laptop's LAN IP:
#   macOS:  ipconfig getifaddr en0      (use en1 for some MBPs on WiFi)
#   linux:  hostname -I | awk '{print $1}'
#   win:    ipconfig (IPv4 of the WiFi adapter)
# Glasses + laptop must be on the same WiFi network.
shiftmind.serverUrl=http://10.0.0.10:8000

# Optional: frames per second the glasses upload to /api/preview-frame.
shiftmind.previewFps=5

# Optional: Android KeyEvent.KEYCODE that toggles AR recording.
# Default 66 = KEYCODE_ENTER (touchpad single-tap on Rokid RG-glasses).
#
# DO NOT use 82 (KEYCODE_MENU) — that's the power button on Rokid, and
# native firmware intercepts it for the photo shortcut. The press never
# reaches the app.
#
# Every keycode received by MainActivity is logged at INFO under tag
# `ShiftMind.Main`. Press a physical button, then:
#   adb logcat -s ShiftMind.Main:V
# Use whatever appears there. Reference:
# developer.android.com/reference/android/view/KeyEvent
shiftmind.recordingKey=66

# Optional: Android KeyEvent.KEYCODE that stops the active customer session
# voice/transcript flow. Keep this different from shiftmind.recordingKey so
# AR recording can run across the whole experiment while sessions end inside it.
# Default 23 = KEYCODE_DPAD_CENTER.
shiftmind.sessionKey=23

# Optional: extra rotation applied to the camera texture before encoding.
# Default -90 matches the server preview rotation: raw 640x480 sensor input
# encoded upright into 480x640. If a future Rokid model tilts the recording,
# try 0/90/180.
shiftmind.recordingRotation=0
